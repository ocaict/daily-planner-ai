{
  "appId": "com.dailyplanner.ai",
  "appName": "Daily Planner AI",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#4361ee",
      "showSpinner": false
    },
    "CapacitorSQLite": {
      "iosDatabaseLocation": "Library/CapacitorDatabase",
      "iosIsEncryption": false,
      "iosKeychainPrefix": "daily-planner-ai",
      "androidIsEncryption": false
    }
  }
}
